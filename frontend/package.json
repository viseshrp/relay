{
  "name": "relay-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:dist": "tsc --noEmit && vite build && node scripts/compress.mjs",
    "test:build": "node --test scripts/*.test.mjs",
    "test": "npm run lint && npm run format:check && npm run test:build && npm run build && playwright test && playwright test --config playwright.no-login.config.ts",
    "test:e2e": "npm test",
    "capture:welcome": "playwright test --config playwright.capture.config.ts",
    "lint": "eslint src e2e *.ts scripts *.mjs --max-warnings 0",
    "format:check": "prettier --check src e2e scripts *.ts *.mjs *.json .prettierrc.json"
  },
  "dependencies": {
    "@actions/expressions": "0.3.61",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@mui/material": "9.4.0",
    "@pierre/diffs": "1.5.1",
    "@xyflow/react": "12.11.6",
    "codemirror": "6.0.2",
    "driver.js": "1.9.0",
    "embla-carousel-react": "8.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-syntax-typescript": "7.29.7",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
